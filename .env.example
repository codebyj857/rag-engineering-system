# Groq API
GROQ_API_KEY=

# Application
ENVIRONMENT=development
DEBUG=true

# API
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_URL=http://127.0.0.1:5500

# LLM
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.2

# Retrieval
DEFAULT_RETRIEVAL_STRATEGY=reranked
DEFAULT_TOP_K=5

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=120